# Production Environment Variables Template
# Copy this file and configure for your Azure deployment

# API Configuration (REQUIRED)
NEXT_PUBLIC_API_URL=https://your-api.azurewebsites.net
NEXT_PUBLIC_API_BASE=https://your-api.azurewebsites.net

# Authentication Configuration (OPTIONAL)
NEXT_PUBLIC_OIDC_ISSUER=https://your-keycloak-instance.com/realms/dpp
NEXT_PUBLIC_CLIENT_ID=dpp-portal

# NextAuth Configuration (if using NextAuth)
# NEXTAUTH_URL=https://your-portal.azurewebsites.net
# NEXTAUTH_SECRET=your-secret-here

# Node Environment (auto-configured by Azure)
# NODE_ENV=production
# PORT=8080
