{
  "$id": "https://example.org/dpp/schemas/core/1-1-0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DPP Core Envelope",
  "$comment": "Archiving & persistence are handled by platform policy (DB/object store, backups, retention/WORM) aligned with prEN 18221; the EU DPP registry underpins minimum preservation/permanence of identifiers (see prEN 18219).",
  "type": "object",
  "required": ["id", "idScheme", "idGranularity", "schemaVersion", "dppUrl", "product", "provenance"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Globally unique, web-resolvable identifier constructed per prEN 18219 (e.g., ISO/IEC 18975 structured path or query using ISO/IEC 15459 AIs/DIs; IEC 61406 Identification Link URL; W3C DID; DOI URL)."
    },
    "idScheme": {
      "type": "string",
      "description": "Declares which prEN 18219-compliant scheme is used to construct 'id'.",
      "enum": [
        "WEB_STRUCTURED_PATH_AI_15459_18975",
        "WEB_QUERY_DI_15459_18975",
        "IEC_61406_IL",
        "DID_W3C",
        "RFID_SYNTAX_15434_15961_17360",
        "DOI_ISO_26324"
      ]
    },
    "idGranularity": {
      "type": "string",
      "description": "Granularity of the unique product identifier as required by prEN 18219.",
      "enum": ["model", "batch", "item"]
    },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "dppUrl": { "type": "string", "format": "uri" },

    "registryId": {
      "type": "string",
      "description": "Optional registry-issued handle for the passport record (e.g., upon submission to a DPP registry)."
    },

    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },

    "product": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "gtin": { "type": "string" },
        "model": { "type": "string" },
        "batchOrLot": { "type": "string" },
        "serialNumber": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "identifiers": {
          "type": "object",
          "description": "Product identifiers including materials and battery component metadata",
          "properties": {
            "productIds": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "description": "Type of identifier (e.g., GTIN, SKU, internal)" },
                  "value": { "type": "string" }
                },
                "required": ["type", "value"]
              }
            },
            "materials": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "description": "Material name (e.g., wood, steel)" },
                  "type": { "type": "string" },
                  "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
                  "origin": { "type": "string" },
                  "certifications": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["name"]
              }
            },
            "batteryMetadata": {
              "type": "object",
              "description": "Battery component metadata if applicable",
              "properties": {
                "chemistry": { "type": "string" },
                "capacity": { "type": "string" },
                "voltage": { "type": "string" },
                "components": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },

    "provenance": {
      "type": "object",
      "required": ["operatorId"],
      "properties": {
        "operatorId": {
          "type": "string",
          "description": "Unique economic-operator identifier (LEI preferred where available)."
        },
        "facilityId": {
          "type": "string",
          "description": "Unique facility identifier (e.g., GLN) where available."
        },
        "facilityIds": {
          "type": "array",
          "description": "Multiple facility identifiers if product involves multiple facilities",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "description": "Type of facility (e.g., manufacturing, assembly, testing)" },
              "location": { "type": "string" }
            },
            "required": ["id"]
          }
        },
        "supplierIds": {
          "type": "array",
          "description": "Supplier information",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string", "description": "Type of supplier (e.g., raw material, component)" },
              "legalEntityIdentifier": { "type": "string", "description": "LEI or equivalent" }
            },
            "required": ["id"]
          }
        },
        "countryOfOrigin": { "type": "string" },
        "manufactureDate": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },

    "compliance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scheme", "reference"],
        "properties": {
          "scheme": { "type": "string" },
          "reference": { "type": "string" },
          "validFrom": { "type": "string", "format": "date" },
          "validTo": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    },

    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "url"],
        "properties": {
          "type": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "hash": { "type": "string" },
          "mime": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "substancesOfConcern": {
      "type": "array",
      "description": "Substances of concern present in the product",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "casNumber": { "type": "string", "description": "CAS Registry Number" },
          "concentration": { "type": "number", "description": "Concentration in percentage or ppm" },
          "unit": { "type": "string", "enum": ["percentage", "ppm", "mg/kg"] },
          "regulatoryList": { "type": "string", "description": "E.g., REACH SVHC, RoHS" },
          "location": { "type": "string", "description": "Where in the product this substance is located" }
        },
        "required": ["name"]
      }
    },

    "environmentalFootprint": {
      "type": "object",
      "description": "Environmental footprint data or link to it",
      "properties": {
        "productCarbonFootprint": {
          "type": "object",
          "properties": {
            "value": { "type": "number", "description": "PCF value" },
            "unit": { "type": "string", "default": "kg CO2e" },
            "scope": { "type": "string", "enum": ["cradle-to-gate", "cradle-to-grave", "gate-to-gate"] },
            "calculationMethod": { "type": "string" },
            "dataQuality": { "type": "string" }
          }
        },
        "externalLink": {
          "type": "string",
          "format": "uri",
          "description": "Link to external environmental footprint data"
        },
        "waterFootprint": { "type": "number" },
        "energyConsumption": { "type": "number" }
      }
    },

    "circularity": {
      "type": "object",
      "description": "Circularity and recyclability information",
      "properties": {
        "recyclabilityScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of product that can be recycled"
        },
        "recyclabilityInformation": {
          "type": "object",
          "properties": {
            "recyclableMaterials": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "material": { "type": "string" },
                  "percentage": { "type": "number" },
                  "recyclingProcess": { "type": "string" }
                }
              }
            },
            "disposalGuidelines": {
              "type": "string",
              "description": "Instructions for proper disposal"
            },
            "eolInstructions": {
              "type": "string",
              "description": "End-of-life instructions"
            }
          }
        },
        "recycledContent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of recycled content in the product"
        },
        "repairability": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "Repairability score (TBC)"
            },
            "assessmentMethod": { "type": "string" },
            "spareParts": {
              "type": "object",
              "properties": {
                "availability": { "type": "string" },
                "period": { "type": "string" }
              }
            }
          }
        },
        "designForDisassembly": { "type": "boolean" },
        "circulatoryPotential": { "type": "string" }
      }
    },

    "planningInsights": {
      "type": "object",
      "description": "Planning insights (initially empty)",
      "properties": {
        "demandForecast": { "type": "string" },
        "supplyChainOptimization": { "type": "string" },
        "maintenanceSchedule": { "type": "string" },
        "customInsights": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },

    "profiles": {
      "type": "object",
      "description": "Map of product-group profiles by namespace.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "_profile": {
            "type": "object",
            "required": ["namespace", "version"],
            "properties": {
              "namespace": { "type": "string" },
              "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "idScheme": { "const": "DID_W3C" } }, "required": ["idScheme"] },
      "then": { "properties": { "id": { "pattern": "^did:[a-z0-9]+:.+" } } }
    },
    {
      "if": { "properties": { "idScheme": { "const": "DOI_ISO_26324" } }, "required": ["idScheme"] },
      "then": { "properties": { "id": { "pattern": "^https?://(dx\\.)?doi\\.org/.+" } } }
    },
    {
      "if": { "properties": { "idScheme": { "const": "WEB_STRUCTURED_PATH_AI_15459_18975" } }, "required": ["idScheme"] },
      "then": { "properties": { "id": { "pattern": "/(01|8006)/[0-9]{8,14}(/10/[^/?#]+)?(/21/[^/?#]+)?($|\\?|#)" } } }
    },
    {
      "if": { "properties": { "idScheme": { "const": "WEB_QUERY_DI_15459_18975" } }, "required": ["idScheme"] },
      "then": { "properties": { "id": { "pattern": "^https?://[^\\s?#]+\\?(.+)$" } } }
    },
    {
      "if": { "properties": { "idScheme": { "const": "IEC_61406_IL" } }, "required": ["idScheme"] },
      "then": { "properties": { "id": { "pattern": "^https?://[^\\s]+/.+" } } }
    }
  ],
  "additionalProperties": false
}
